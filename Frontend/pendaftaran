<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal Beasiswa - Telkom University</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        body {
            display: flex;
            min-height: 100vh;
            background-color: #f5f5f5;
        }
        
        .sidebar {
            width: 275px;
            background-color: #c02131;
            color: white;
            display: flex;
            flex-direction: column;
        }
        
        .sidebar-header {
            padding: 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.2);
        }
        
        .sidebar-header h1 {
            font-size: 24px;
            font-weight: bold;
        }
        
        .sidebar-header p {
            font-size: 14px;
        }
        
        .sidebar-menu {
            padding: 20px 0;
            flex-grow: 1;
        }
        
        .menu-item {
            padding: 10px 20px;
            display: flex;
            align-items: center;
            cursor: pointer;
            border-left: 4px solid transparent;
        }
        
        .menu-item.active {
            background-color: rgba(255, 255, 255, 0.1);
            border-left: 4px solid white;
        }
        
        .menu-item:hover {
            background-color: rgba(255, 255, 255, 0.1);
        }
        
        .menu-item i {
            margin-right: 10px;
            font-size: 18px;
        }
        
        .sidebar-footer {
            padding: 20px;
            text-align: center;
            border-top: 1px solid rgba(255, 255, 255, 0.2);
        }
        
        .main-content {
            flex-grow: 1;
            padding: 20px;
            background-color: #f5f5f5;
        }
        
        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 20px;
            background-color: white;
            margin-bottom: 20px;
        }
        
        .menu-toggle {
            display: none;
            font-size: 24px;
            cursor: pointer;
        }
        
        .top-actions {
            display: flex;
            align-items: center;
        }
        
        .top-actions .icon {
            margin-left: 20px;
            position: relative;
            cursor: pointer;
        }
        
        .top-actions .icon .badge {
            position: absolute;
            top: -5px;
            right: -5px;
            background-color: #e74c3c;
            color: white;
            font-size: 10px;
            width: 16px;
            height: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
        }
        
        .user-avatar {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background-color: #777;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
            margin-left: 15px;
        }
        
        .content-header {
            margin-bottom: 20px;
        }
        
        .content-header h2 {
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 20px;
        }
        
        .user-info {
            display: flex;
            background-color: white;
            padding: 20px;
            border-radius: 5px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
            margin-bottom: 20px;
        }
        
        .user-photo {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background-color: #e6e6e6;
            margin-right: 20px;
            overflow: hidden;
            position: relative;
        }
        
        .user-photo .avatar {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(to bottom, #d67373 0%, #d67373 50%, #c96363 50%, #c96363 100%);
            border-radius: 50%;
        }
        
        .user-details {
            flex-grow: 1;
            display: flex;
            flex-wrap: wrap;
        }
        
        .user-details h3 {
            font-size: 18px;
            margin-bottom: 10px;
            width: 100%;
        }
        
        .detail-column {
            flex: 1;
            min-width: 200px;
            margin-right: 20px;
        }
        
        .detail-item {
            margin-bottom: 10px;
        }
        
        .detail-item p {
            font-size: 12px;
            color: #777;
            margin-bottom: 3px;
        }
        
        .detail-item strong {
            font-size: 14px;
        }
        
        .badge-gpa {
            background-color: #3498db;
            color: white;
            padding: 2px 8px;
            border-radius: 3px;
            font-size: 12px;
            display: inline-block;
        }
        
        .progress-steps {
            display: flex;
            justify-content: space-between;
            margin-bottom: 30px;
            position: relative;
        }
        
        .progress-steps::before {
            content: '';
            position: absolute;
            top: 18px;
            left: 0;
            right: 0;
            height: 2px;
            background-color: #ddd;
            z-index: 1;
        }
        
        .step {
            position: relative;
            z-index: 2;
            text-align: center;
            width: 80px;
        }
        
        .step-icon {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background-color: white;
            border: 2px solid #ddd;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 5px;
        }
        
        .step.active .step-icon {
            border-color: #3498db;
            background-color: #3498db;
            color: white;
        }
        
        .step.completed .step-icon {
            border-color: #2ecc71;
            background-color: #2ecc71;
            color: white;
        }
        
        .step-label {
            font-size: 12px;
            color: #777;
        }
        
        .step.active .step-label {
            color: #3498db;
            font-weight: bold;
        }
        
        .step.completed .step-label {
            color: #2ecc71;
            font-weight: bold;
        }
        
        .content-section {
            background-color: white;
            padding: 20px;
            border-radius: 5px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
            margin-bottom: 20px;
        }
        
        .content-section h3 {
            font-size: 16px;
            margin-bottom: 10px;
            padding-bottom: 10px;
            border-bottom: 1px solid #eee;
        }
        
        .content-section p {
            font-size: 12px;
            color: #777;
            margin-bottom: 15px;
        }
        
        .upload-area {
            border: 2px dashed #ddd;
            border-radius: 5px;
            padding: 30px;
            text-align: center;
            margin-bottom: 10px;
            cursor: pointer;
            transition: all 0.3s;
        }
        
        .upload-area:hover {
            border-color: #3498db;
        }
        
        .upload-icon {
            font-size: 36px;
            color: #aaa;
            margin-bottom: 10px;
        }
        
        .upload-text {
            color: #777;
            font-size: 14px;
            margin-bottom: 5px;
        }
        
        .upload-format {
            color: #999;
            font-size: 12px;
        }
        
        .template-link {
            color: #3498db;
            text-decoration: none;
            font-size: 12px;
            display: inline-block;
            margin-top: 10px;
        }
        
        .template-link:hover {
            text-decoration: underline;
        }
        
        .form-group {
            margin-bottom: 15px;
        }
        
        .form-group label {
            display: block;
            font-size: 14px;
            margin-bottom: 5px;
            color: #555;
        }
        
        .form-control {
            width: 100%;
            padding: 8px 12px;
            font-size: 14px;
            border: 1px solid #ddd;
            border-radius: 4px;
        }
        
        .btn {
            padding: 8px 16px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 14px;
            font-weight: bold;
            transition: all 0.3s;
        }
        
        .btn-primary {
            background-color: #c02131;
            color: white;
        }
        
        .btn-primary:hover {
            background-color: #a51c29;
        }
        
        .btn-secondary {
            background-color: #f5f5f5;
            color: #333;
            border: 1px solid #ddd;
        }
        
        .btn-secondary:hover {
            background-color: #e5e5e5;
        }
        
        .form-actions {
            display: flex;
            justify-content: space-between;
            margin-top: 20px;
        }
        
        .progress-label {
            display: inline-block;
            padding: 2px 8px;
            background-color: #ffeaa7;
            color: #d35400;
            border-radius: 3px;
            font-size: 12px;
            margin-bottom: 10px;
        }
        
        .modal {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: rgba(0, 0, 0, 0.5);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1000;
        }
        
        .modal-content {
            background-color: white;
            padding: 20px;
            border-radius: 5px;
            width: 400px;
            max-width: 90%;
            text-align: center;
        }
        
        .modal-icon {
            font-size: 48px;
            color: #e74c3c;
            margin-bottom: 15px;
        }
        
        .modal-title {
            font-size: 18px;
            margin-bottom: 10px;
        }
        
        .modal-text {
            color: #777;
            margin-bottom: 20px;
        }
        
        .btn-close {
            background-color: #e74c3c;
            color: white;
        }
        
        .btn-close:hover {
            background-color: #c0392b;
        }
        
        .letter-upload-area {
            border: 2px dashed #ddd;
            border-radius: 5px;
            padding: 30px;
            text-align: center;
            margin-bottom: 10px;
            cursor: pointer;
            transition: all 0.3s;
        }
        
        .letter-upload-area:hover {
            border-color: #3498db;
        }
        
        .letter-upload-area p {
            margin-bottom: 10px;
        }
        
        .browse-btn {
            background-color: #f5f5f5;
            color: #333;
            border: 1px solid #ddd;
            padding: 6px 12px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 14px;
            transition: all 0.3s;
        }
        
        .browse-btn:hover {
            background-color: #e5e5e5;
        }
        
        .requirements-list {
            margin-top: 15px;
        }
        
        .requirement-item {
            display: flex;
            align-items: center;
            margin-bottom: 5px;
            font-size: 13px;
            color: #555;
        }
        
        .requirement-item i {
            color: #2ecc71;
            margin-right: 8px;
        }
        
        .page-indicator {
            text-align: right;
            margin-top: 10px;
            font-size: 12px;
            color: #777;
        }
        
        @media screen and (max-width: 768px) {
            body {
                flex-direction: column;
            }
            
            .sidebar {
                width: 100%;
                display: none;
            }
            
            .sidebar.active {
                display: block;
            }
            
            .menu-toggle {
                display: block;
            }
            
            .user-details {
                flex-direction: column;
            }
            
            .detail-column {
                margin-right: 0;
                margin-bottom: 15px;
            }
            
            .progress-steps {
                flex-wrap: wrap;
            }
            
            .step {
                margin-bottom: 10px;
            }
        }
    </style>
</head>
