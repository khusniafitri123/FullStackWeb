    <script>
        // Toggle sidebar on mobile
        document.querySelector('.menu-toggle').addEventListener('click', function() {
            document.querySelector('.sidebar').classList.toggle('active');
        });
        
        // Show modal example (for demonstration purposes)
        // document.addEventListener('DOMContentLoaded', function() {
        //     setTimeout(function() {
        //         document.querySelector('.modal').style.display = 'flex';
        //     }, 3000);
        // });
        
        // Close modal
        document.querySelector('.btn-close').addEventListener('click', function() {
            document.querySelector('.modal').style.display = 'none';
        });
        
        // File upload functionality
        const uploadAreas = document.querySelectorAll('.upload-area, .letter-upload-area');
        uploadAreas.forEach(area => {
            area.addEventListener('click', function() {
                const fileInput = document.createElement('input');
                fileInput.type = 'file';
                fileInput.accept = '.pdf,.jpg,.jpeg,.png';
                fileInput.click();
                
                fileInput.addEventListener('change', function() {
                    if (fileInput.files.length > 0) {
                        // Handle file upload (in a real app, you would send this to a server)
                        const fileName = fileInput.files[0].name;
                        alert('File selected: ' + fileName);
                    }
                });
            });
            
            area.addEventListener('dragover', function(e) {
                e.preventDefault();
                area.style.borderColor = '#3498db';
                area.style.backgroundColor = '#f8f9fa';
            });
            
            area.addEventListener('dragleave', function() {
                area.style.borderColor = '#ddd';
                area.style.backgroundColor = 'transparent';
            });
            
            area.addEventListener('drop', function(e) {
                e.preventDefault();
                area.style.borderColor = '#ddd';
                area.style.backgroundColor = 'transparent';
                
                if (e.dataTransfer.files.length > 0) {
                    // Handle file upload (in a real app, you would send this to a server)
                    const fileName = e.dataTransfer.files[0].name;
                    alert('File dropped: ' + fileName);
                }
            });
        });
        
        // Browse files button
        document.querySelector('.browse-btn').addEventListener('click', function(e) {
            e.preventDefault();
            const fileInput = document.createElement('input');
            fileInput.type = 'file';
            fileInput.accept = '.pdf,.jpg,.jpeg,.png';
            fileInput.click();
            
            fileInput.addEventListener('change', function() {
                if (fileInput.files.length > 0) {
                    // Handle file upload (in a real app, you would send this to a server)
                    const fileName = fileInput.files[0].name;
                    alert('File selected: ' + fileName);
                }
            });
        });
    </script>
</body>
</html>
